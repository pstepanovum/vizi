# Copy to .env and fill in. EXPO_PUBLIC_* values are inlined into the client
# bundle at build time — use per-developer test keys, never production secrets.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_FISH_AUDIO_API_KEY=
# Firebase console → Authentication → Google provider → Web SDK configuration:
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# RevenueCat dashboard → Apps → Vizi iOS → public SDK key (appl_...):
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Optional overrides:
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
# EXPO_PUBLIC_FISH_AUDIO_MODEL=s1
# EXPO_PUBLIC_SPEECH_LANG=en-US
# EXPO_PUBLIC_FISH_AUDIO_VOICE_ID=933563129e564b19a115bedd57b7406a
