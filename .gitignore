# macOS
.DS_Store

# Secrets — never commit credentials
vizi-mobile/scripts/.env.release
vizi-assets/apple/*.p8
vizi-assets/firebase/*adminsdk*.json
vizi-assets/firebase/*.zip
**/GoogleService-Info.plist
.env
.env.*
!.env.example

# Fonts — licensed assets stay local
vizi-assets/font/
vizi-mobile/assets/fonts/
vizi-assets/screenshot-studio/public/fonts/Chunk.*

# Screenshot studio — generated output and re-downloadable demo photos.
# The studio source itself IS committed; see its README.
vizi-assets/screenshot-studio/node_modules/
vizi-assets/screenshots/
vizi-assets/screenshot-studio/public/scenes/*.jpg
vizi-assets/screenshot-studio/dist/

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated with `expo prebuild`
vizi-mobile/ios/
vizi-mobile/android/

# Metro
.metro-health-check*

